{
  "name": "mieru",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "考えを整理し、そのまま AI に渡せるマインドマップツール",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:core": "vitest run src/core",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "mind-elixir": "5.15.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "yaml": "2.9.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/mdast": "4.0.4",
    "@types/node": "20.19.43",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "eslint-config-prettier": "10.1.8",
    "fake-indexeddb": "6.2.5",
    "fast-check": "4.9.0",
    "prettier": "3.9.6",
    "sharp": "0.35.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.69.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
